<Window x:Class="DigitDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digit Display" Height="590" Width="1060"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="LayouRoot" Padding="5" 
            BorderBrush="{StaticResource ApplicationForeground}"
            Background="{StaticResource ApplicationBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                <ComboBox x:Name="LeftClassifier">
                    <ComboBoxItem Content="Euclidean Classifier"
                              Tag="EuclideanClassifier"
                              IsSelected="True"/>
                    <ComboBoxItem Content="Manhattan Classifier"
                              Tag="ManhattanClassifier" />
                </ComboBox>
                <ComboBox x:Name="LeftControl"/>

            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal"                    
                    HorizontalAlignment="Center">
                <ComboBox x:Name="RightClassifier">
                    <ComboBoxItem Content="Euclidean Classifier"
                              Tag="EuclideanClassifier"
                              IsSelected="True"/>
                    <ComboBoxItem Content="Manhattan Classifier"
                              Tag="ManhattanClassifier" />
                </ComboBox>
                <ComboBox x:Name="RightControl"/>

            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftPanel" Grid.Column="0"/>
                    <StackPanel x:Name="RightPanel" Grid.Column="1"/>
                </Grid>
            </ScrollViewer>
            <Button x:Name="GoButton" Content="Go" 
                    Grid.Row="2" Grid.Column="4"
                    Width="230" HorizontalAlignment="Right"
                    Style="{StaticResource GoButtonStyle}"
                    Click="GoButton_Click"/>
            <Grid Grid.Row="2" Grid.Column="2" 
                  HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Record Count: "  />
                <TextBox Grid.Column="1" Grid.Row="0" 
                         x:Name="RecordCount" Text="325" Height="30" Width="75" 
                         VerticalAlignment="Top"
                         FontWeight="Bold"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Offset: " />
                <TextBox Grid.Column="1" Grid.Row="1" 
                         x:Name="Offset" Text="0" Width="75" FontWeight="Bold"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Output Size: " />
                <TextBox Grid.Column="1" Grid.Row="2" 
                         x:Name="OutputSize" Text="1.0" Width="75" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Border>
</Window>
